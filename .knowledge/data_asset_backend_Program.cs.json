{"is_source_file": true, "format": "C#", "description": "This file is the main startup/configuration code for a .NET web API backend for a data asset management system. It sets up services, middleware, routing, authentication, authorization policies, Swagger/OpenAPI documentation, CORS policies, health checks, and defines numerous API endpoints for assets, lineage, validation, and auth. It also handles environment configuration, database connection setup, Swagger UI customization, and includes some legacy API endpoints.", "external_files": ["DataAssetBackend.Features.Assets", "DataAssetBackend.Features.Legacy", "DataAssetBackend.Features.Masters", "DataAssetBackend.Features.Section4", "DataAssetBackend.Infrastructure.Api", "DataAssetBackend.Infrastructure.Auth", "DataAssetBackend.Infrastructure.Database", "DataAssetBackend.Infrastructure.Idempotency", "Microsoft.AspNetCore.Authentication.JwtBearer", "Microsoft.AspNetCore.Authorization", "Microsoft.AspNetCore.HttpOverrides", "Microsoft.AspNetCore.Mvc", "Microsoft.IdentityModel.Tokens", "Npgsql", "NSwag", "NSwag.Generation.Processors.Security"], "external_methods": ["LoadDotEnvIfPresent", "RequestValidation.ValidateAndThrow", "AssetFlows.CreateAssetAsync", "AssetFlows.GetAssetAsync", "AssetFlows.UpdateAssetAsync", "AssetFlows.QueryAssetsAsync", "AssetFlows.DeleteAssetAsync", "AssetCopyFlows.CopyAssetAsync", "AssetCopyLineageFlows.CreateAsync", "AssetCopyLineageFlows.QueryAsync", "DatabaseHealthCheckFlow.RunAsync", "app.UseUnifiedExceptionHandling"], "published": ["HealthRootResponse", "HealthzDbStatus", "HealthzResponse", "ValidilityCheckRequest", "ValidityCheckResponse"], "classes": [{"name": "ValidityCheckRequest", "description": "Request payload class for the validity check endpoint, requiring a non-empty string 'Value'."}, {"name": "ValidityCheckResponse", "description": "Response payload class indicating whether a value is valid and an optional reason."}, {"name": "HealthRootResponse", "description": "Record repr